extends layout

block content
  .container
    .jumbotron
      .container
        h1= title
        div#status(style='height: 35px')
          - if (status.length === 0)
            span.label.label-danger Offline
          - if (status.length !== 0)
            - if (status[0].pm2_env.status === 'online')
              .row
                .col-sm-2.text-left-xs.text-right-md
                  span.label.label-success Online
          - if (status === undefined)
            .row
              .col-sm-6
                p Process monitor is not running!
          - if (status !== undefined)
            div
              - each i in status
                hr
                .row
                  .col-sm-3.text-left-xs.text-right-md
                    p Name:
                  .col-sm-9
                    p #{i.name}
                .row
                  .col-sm-3.text-left-xs.text-right-md
                    p Env:
                  .col-sm-9
                    p #{i.pm2_env.APPLICATION_ENV}
                .row
                  .col-sm-3.text-left-xs.text-right-md
                    p Memory:
                  .col-sm-9
                    p=(i.monit.memory /1024)/1024 + ' MB'
                .row
                  .col-sm-3.text-left-xs.text-right-md
                    p Restarts:
                  .col-sm-9
                    p #{i.pm2_env.restart_time}
                .row
                  .col-sm-3.text-left-xs.text-right-md
                    p Started:
                  .col-sm-9
                    p=moment(i.pm2_env.pm_uptime).format("MMM Do YYYY, HH:mm:ss")
            div#status(style="height: 35px")

  include footer
