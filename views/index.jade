extends layout

block content
  .container
    .jumbotron
      .container
        h1= title
        div#status(style='height: 35px')
          - if (status.length === 0)
            span.label.label-danger Offline
          - if (status.length !== 0)
            - if (status[0].pm2_env.status === 'online')
              .row
                .col-sm-2.text-left-xs.text-right-md
                  span.label.label-success Online
          - if (status === undefined)
            .row
              .col-sm-6
                p Process monitor is not running!
          - if (status !== undefined)
            div
              - each i in status
                hr
                .row
                  .col-xs-6.col-sm-6.col-md-6
                    p Name:
                  .col-sm-6
                    p #{i.name}
                .row
                  .col-xs-6.col-sm-6.col-md-6
                    p Env:
                  .col-sm-6
                    p #{i.pm2_env.APPLICATION_ENV}
                .row
                  .col-xs-6.col-sm-6.col-md-6
                    p Memory:
                  .col-sm-6
                    p#memory=(i.monit.memory /1024)/1024 + ' MB'
                    script
                        |$(function () {
                        |  socket.on('memory', function (data) {
                        |    $('#memory').replaceWith('<p id="memory"> ' + (data[0].monit.memory /1024)/1024 + ' MB' + '</p>');
                        |  });
                        |});

                .row
                  .col-xs-6.col-sm-6.col-md-6
                    p Restarts:
                  .col-sm-6
                    p #{i.pm2_env.restart_time}
                .row
                  .col-xs-6.col-sm-6.col-md-6
                    p Started:
                  .col-sm-6
                    p=moment(i.pm2_env.pm_uptime).format("MMM Do YYYY, HH:mm:ss")
                .row
                  .col-xs-12.col-sm-12.col-md-12
                    canvas#lineChart(width='100%', height='20%')
                    script(src='js/Chart.js')
                    script(src='js/main.js')
            div#status(style="height: 35px")
            

  include footer
