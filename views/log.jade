extends layout

block content
  .container
    .jumbotron
      .container
        h1= title
        table.table.table-condensed.table-striped#log
          - each i, key in log
            tr
              td #{i}
              
  script(src='socket.io/socket.io.js')
  script
      |$(function () {
      |  socket = io.connect();
      |  socket.on('newLine', function (data) {
      |    $('table').append('<tr><td>' + data + '</td></tr>');
      |    $("html, body").animate({ scrollTop: $(document).height() }, 1000);
      |  });
      |});
  include footer
