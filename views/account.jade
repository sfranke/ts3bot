extends layout

block content

  .container
    .jumbotron
      .container
        h1= title
        form(name='getAccountInfo', method='post', action='/account')
          div.form-group
            div.row
              div.col-xs-6.col-sm-3.col-md-2
                button.btn.btn-lg.btn-info Account Info
              div.col-xs-6.col-sm-8.col-md-10
                input.inputUid.form-control(type='accountname', autofocus='', required='', placeholder='Uid', name='accountUid')

        //div#test
          //h2 TEST
          //button.btn.btn-sm.btn-info(type='submit')#12 Test
          //p#test MyTestParagraph
          //p#test2
          //script
            //|  $('#12').on('click', function() {
            //|    var guilds = $('p#test2').html('#{guilds}');
            //|  });

        - if (name != undefined)
          div.container
            div.row
              div.col-xs-6
                h2 Name
                P #{name}
              div.col-xs-6
                h2 Time
                P #{time}
            //- if (apiKey != undefined)
            //  div.row
            //    div.col-xs-10
            //      h2 API-Key
            //      p #{apiKey}
            - if (accountName != undefined)
              div.row
                div.col-xs-6
                  h2 Account Name
                  P #{accountName}
                div.col-xs-6
                  h2 Account ID
                  P #{accountId}
            - if (created != undefined)
              div.row
                div.col-xs-6
                  h2 Created
                  p #{created}
                - if (guilds != undefined)
                  div.col-xs-6
                    h2 Guilds
                    p#guilds
                    - each i, key in guilds
                      div#test(name='#{i}')
                        button.btn.btn-sm.btn-info(id='#{i}', type='submit') #{i}
                        p#test2(class='#{i}')
                        script
                          |$(document).ready(function(){
                          |  $('##{i}').on('click', function() {
                          |    $.getJSON('/guild/#{i}', function(d) {
                          |      $('##{i}').replaceWith('<p>' + '[' + d.tag + '] ' + d.guild_name + '</p>');
                          |    });
                          |  });
                          |});

  include footer