extends layout

block content

  .container
    .jumbotron
      .container
        h1= title
        div
          form(name='getAccountInfo', method='post')
            input.inputUid.form-control(type='accountname', autofocus='', required='', placeholder='Uid', name='accountUid')
            button.btn.btn-lg.btn-info(type='submit') Account Info

        //div#test
          //h2 TEST
          //button.btn.btn-sm.btn-info(type='submit')#12 Test
          //p#test MyTestParagraph
          //p#test2
          //script
            //|  $('#12').on('click', function() {
            //|    var guilds = $('p#test2').html('#{guilds}');
            //|  });

        - if (name != undefined)
          div.container
            div.row
              div.col-xs-6
                h2 Name
                P #{name}
              div.col-xs-6
                h2 Time
                P #{time}
            - if (apiKey != undefined)
              div.row
                div.col-xs-10
                  h2 API-Key
                  p #{apiKey}
            - if (accountName != undefined)
              div.row
                div.col-xs-6
                  h2 Account Name
                  P #{accountName}
                div.col-xs-6
                  h2 Account ID
                  P #{accountId}
            - if (created != undefined)
              div.row
                div.col-xs-6
                  h2 Created
                  p #{created}
                - if (guilds != undefined)
                  div.col-xs-6
                    h2 Guilds
                    - each i, key in guilds
                      div#test(name='#{i}')
                        button.btn.btn-sm.btn-info(id='#{i}', type='submit') #{i}
                        p#test2(class='#{i}')
                        p#info
                        //script
                        //  |  $('##{i}').on('click', function() {
                        //  |    $.getJSON('/guild/#{i}', function() {
                        //  |      console.log(#{guild_name});
                        //  |    });
                        //  |  });
                        p #{i}

  include footer