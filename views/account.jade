extends layout

block content

  .container
    .jumbotron
      .container
        h1= title
        div
          form(name='getAccountInfo', method='post')
            input.inputUid.form-control(type='accountname', autofocus='', required='', placeholder='Uid', name='accountUid')
            button.btn.btn-lg.btn-info(type='submit') Account Info

        div#test
          h2 TEST
          button.btn.btn-sm.btn-info(type='submit')#12 Test
          p#test MyTestParagraph
          p#test2
          script
            |  $('#12').on('click', function() {
            |    var guilds = $('p#test2').html('#{guilds}');
            |  });

        - if (name != undefined)
          div.container
            div.row
              div.col-xs-6
                h2 Name
                P #{name}
              div.col-xs-6
                h2 Time
                P #{time}
            - if (apiKey != undefined)
              div.row
                div.col-xs-10
                  h2 API-Key
                  p #{apiKey}
            - if (accountName != undefined)
              div.row
                div.col-xs-6
                  h2 Account Name
                  P #{accountName}
                div.col-xs-6
                  h2 Account ID
                  P #{accountId}
            - if (guilds != undefined)
              div.row
                div.col-xs-12
                  h2 Guilds
                  p #{guilds}
            - if (created != undefined)
              div.row
                div.col-xs-12
                  h2 Created
                  p #{created}

  include footer