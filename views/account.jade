extends layout

block content

  .container
    .jumbotron
      .container
        h1= title
        form(id='AccountInfo', name='getAccountInfo', method='post', action='/account')
          div.form-group
            div.row
              |         
              div.col-xs-6.col-sm-4.col-md-2
                button.btn.btn.custom-btn Account Info
              |         
              div.col-xs-6.col-sm-8.col-md-10
                input.inputUid.form-control(id='inputUid', type='accountname', autofocus='', required='', placeholder='Uid or name', name='accountUid')

        - if (name != undefined)
          - var count = 0;
          - each u in user
            div.container
              hr
              div.row
                div.col-xs-6.col-sm-6.col-md-6
                  h2 Name
                  P=u.client_nickname
                div.col-xs-6.col-sm-6.col-md-6
                  h2 Time
                  - var regex = /[0-9]{10}/g
                    - if (regex.test(u.last_seen) === true)
                      P=moment(u.last_seen * 1000).format("MMM Do YYYY, HH:mm:ss")
                    - else
                      p=u.last_seen
              div.row
                div.col-xs-6.col-sm-6.col-md-6
                  h2 Unique ID
                  P=u.client_unique_id
                div.col-xs-6.col-sm-6.col-md-6
                  h2
                  button.btn.btn-sm.btn-default.custom-btn(id=count) Details
                  script
                    |$(document).ready(function(){
                    |  $('##{count}').on('click', function() {
                    |    $('#inputUid').val('#{u.client_unique_id}');
                    |    $('#AccountInfo').submit();
                    |  });
                    |});
              - if (u.gw2_account_name != undefined)
                div.row
                  div.col-xs-6.col-sm-6.col-md-6
                    h2 Account Name
                    P=u.gw2_account_name
                  div.col-xs-6.col-sm-6.col-md-6
                    h2 Account ID
                    P=u.gw2_account_id
              - if (u.gw2_account_created != undefined)
                div.row
                  div.col-xs-6.col-sm-6.col-md-6
                    h2 Created
                      p=u.gw2_account_created
                  - if (guilds !== undefined)
                    div.col-xs-6.col-sm-6.col-md-6
                      h2 Guilds
                      p#guilds
                      - each i, key in guilds
                        div#test(name='#{i}')
                          button.btn.btn-sm.btn-info(id='#{i}', type='submit', style='display: none;') #{i}
                          p#test2(class='#{i}')
                          script
                            |$(document).ready(function(){
                            |  $.getJSON('/guild/#{i}', function(d) {
                            |    $('##{i}').replaceWith('<p>' + '[' + d.tag + '] ' + d.name + '</p>');
                            |  });
                            |});
            - count++;

  include footer
