extends layout

block content

  .container
    .jumbotron
      .container
        h1= title
        form(name='getAccountInfo', method='post', action='/account')
          div.form-group
            div.row
              div.col-xs-6.col-sm-3.col-md-2
                button.btn.btn-lg.btn-info Account Info
              div.col-xs-6.col-sm-8.col-md-10
                input.inputUid.form-control(type='accountname', autofocus='', required='', placeholder='Uid or name', name='accountUid')

        - if (name != undefined)
          div.container
            div.row
              div.col-xs-6.col-sm-6.col-md-6
                h2 Name
                P #{name}
              div.col-xs-6.col-sm-6.col-md-6
                h2 Time
                P=moment(time).format("MMM Do YYYY, h:mm:ss a")
            - if (accountName != undefined)
              div.row
                div.col-xs-6.col-sm-6.col-md-6
                  h2 Account Name
                  P #{accountName}
                div.col-xs-6.col-sm-6.col-md-6
                  h2 Account ID
                  P #{accountId}
            - if (created != undefined)
              div.row
                div.col-xs-6.col-sm-6.col-md-6
                  h2 Created
                  p=moment(created).format("MMM Do YYYY, h:mm:ss a")
                - if (guilds != undefined)
                  div.col-xs-6.col-sm-6.col-md-6
                    h2 Guilds
                    p#guilds
                    - each i, key in guilds
                      div#test(name='#{i}')
                        button.btn.btn-sm.btn-info(id='#{i}', type='submit', style='display: none;') #{i}
                        p#test2(class='#{i}')
                        script
                          |$(document).ready(function(){
                          |  $.getJSON('/guild/#{i}', function(d) {
                          |    $('##{i}').replaceWith('<p>' + '[' + d.tag + '] ' + d.guild_name + '</p>');
                          |  });
                          |});

  include footer
