extends layout

block content

  .container
    .jumbotron
      .container
        h1= title
        div
          form(name='getAccountInfo', method='post')
            input.inputUid.form-control(type='accountname', autofocus='', required='', placeholder='Uid', name='accountUid')
            button.btn.btn-lg.btn-info(type='submit') Account Info



        - if (name != undefined)
          div.container
            div.col-12
              h2= 'Name'
              div.row #{name}
            -if (time != undefined)
              div.col-12
                h3= 'Time'
                div.row #{time}
            - if (apiKey != undefined)
              div.col-12
                h3= 'API-Key'
                div.row #{apiKey}
            - if (accountId != undefined)
              div.col-12
                h3= 'Account Id'
                div.row #{accountId}
            - if (accountName != undefined)
              div.col-12
                h3= 'Account Name'
                div.row #{accountName}
            - if (guilds != undefined)
              div.col-12
                h3= 'Guilds'
                div.row #{guilds}
            - if (created != undefined)
              div.col-12
                h3= 'Created'
                div.row #{created}


  include footer